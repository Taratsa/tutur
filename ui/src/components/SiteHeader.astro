---
import Icon from "../lib/Icon.svelte";
import { sitePath } from "../lib/site.js";

const { currentPath = "/" } = Astro.props;
const isActive = (path: string) =>
  currentPath === path || (path === "/search/" && currentPath.startsWith("/search"));
---

<header class="site-header">
  <a class="brand" href={sitePath("/")}>
    <img src={sitePath("/favicon.png")} alt="" width="36" height="36" />
    <span><strong>Tutur</strong></span>
  </a>
  <nav class="desktop-nav" aria-label="Navigasi utama">
    <a
      class={isActive("/") ? "active" : undefined}
      aria-current={isActive("/") ? "page" : undefined}
      href={sitePath("/")}><Icon name="home" size={13} />Beranda</a
    >
    <a
      class={isActive("/search/") ? "active" : undefined}
      aria-current={isActive("/search/") ? "page" : undefined}
      href={sitePath("/search/")}><Icon name="search" size={13} />Pencarian</a
    >
    <a
      class={isActive("/kuis/") ? "active" : undefined}
      aria-current={isActive("/kuis/") ? "page" : undefined}
      href={sitePath("/kuis/")}><Icon name="check" size={13} />Kuis</a
    >
    <a
      class={isActive("/tebak-kata/") ? "active" : undefined}
      aria-current={isActive("/tebak-kata/") ? "page" : undefined}
      href={sitePath("/tebak-kata/")}><Icon name="comment" size={13} />Tebak kata</a
    >
  </nav>
</header>
