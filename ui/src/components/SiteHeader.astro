---
import Icon from "../lib/Icon.svelte";
import { repositoryUrl, sitePath } from "../lib/site.js";

const { currentPath = "/" } = Astro.props;
const isActive = (path: string) =>
  currentPath === path || (path === "/search/" && currentPath.startsWith("/search"));
---

<header class="site-header">
  <a class="brand" href={sitePath("/")}>
    <img src={sitePath("/kbbi-logo.png")} alt="" width="46" height="46" />
    <span><strong>KBBI</strong><small>Data Explorer</small></span>
  </a>
  <nav class="desktop-nav" aria-label="Navigasi utama">
    <a
      class={isActive("/") ? "active" : undefined}
      aria-current={isActive("/") ? "page" : undefined}
      href={sitePath("/")}><Icon name="home" size={13} />Beranda</a
    >
    <a
      class={isActive("/search/") ? "active" : undefined}
      aria-current={isActive("/search/") ? "page" : undefined}
      href={sitePath("/search/")}><Icon name="search" size={13} />Pencarian</a
    >
    <a
      class={isActive("/developer/") ? "active" : undefined}
      aria-current={isActive("/developer/") ? "page" : undefined}
      href={sitePath("/developer/")}><Icon name="code" size={14} />Developer</a
    >
  </nav>
  <a
    class="github-button"
    href={repositoryUrl}
    target="_blank"
    rel="noreferrer"
    aria-label="Buka repositori GitHub"><Icon name="github" /></a
  >
</header>
