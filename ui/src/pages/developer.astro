---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../lib/Icon.svelte";
import { loadSiteData } from "../lib/build-data.js";
import { repositoryUrl, sitePath } from "../lib/site.js";

export const prerender = true;

const data = await loadSiteData();
const formatNumber = (value: number) => new Intl.NumberFormat("id-ID").format(value ?? 0);
const datasets = [
  {
    name: "Kamus Utama",
    folder: "edisi-IV",
    type: "Definisi kata",
    records: data.stats.dictionaryRecords,
    formats: [
      "JSON",
      "CSV",
      "MySQL",
      "PostgreSQL",
      "SQLite",
      "XML",
      "HTML",
      "Markdown",
      "PHP Array",
      "DbUnit",
    ],
  },
  {
    name: "Baku & Nonbaku",
    folder: "baku-nonbaku",
    type: "Relasi ejaan",
    records: data.stats.bakuRecords,
    formats: [
      "JSON",
      "CSV",
      "MySQL",
      "PostgreSQL",
      "SQLite",
      "XML",
      "HTML",
      "Markdown",
      "PHP Array",
      "DbUnit",
      "Text",
    ],
  },
  {
    name: "Sinonim",
    folder: "sinonim",
    type: "Relasi makna",
    records: data.stats.sinonimRecords,
    formats: [
      "JSON",
      "CSV",
      "MySQL",
      "PostgreSQL",
      "SQLite",
      "XML",
      "HTML",
      "Markdown",
      "PHP Array",
      "DbUnit",
      "Text",
    ],
  },
  {
    name: "Antonim",
    folder: "antonim",
    type: "Oposisi makna",
    records: data.stats.antonimRecords,
    formats: [
      "JSON",
      "CSV",
      "MySQL",
      "PostgreSQL",
      "SQLite",
      "XML",
      "HTML",
      "Markdown",
      "PHP Array",
      "DbUnit",
      "Text",
    ],
  },
];
const schemas = [
  {
    dataset: "Kamus Utama",
    root: "dictionary",
    fields: ["_id", "word", "arti", "type"],
    note: "type 1 = HTML, type 2 = teks biasa",
  },
  {
    dataset: "Baku & Nonbaku",
    root: "quiz_baku",
    fields: ["id", "word", "wrong", "explain", "clue"],
    note: "clue dapat bernilai null",
  },
  {
    dataset: "Sinonim",
    root: "dictionary_sinonim",
    fields: ["id", "kata_a", "kata_b", "jenis", "penjelasan", "penggunaan_a", "penggunaan_b"],
    note: "Sinonim dan varian baku/nonbaku",
  },
  {
    dataset: "Antonim",
    root: "dictionary_antonim",
    fields: [
      "id",
      "kata_a",
      "kata_b",
      "jenis_oposisi",
      "bidang",
      "tingkat_keyakinan",
      "penjelasan",
      "penggunaan_a",
      "penggunaan_b",
      "catatan",
    ],
    note: "Oposisi kontekstual, komplementer, relasional, dan reversif",
  },
];
---

<BaseLayout
  title="Developer Data | KBBI Explorer"
  description="Koleksi, format file, dan struktur data KBBI Explorer."
  canonicalPath="/developer/"
  currentPath="/developer/"
>
  <PageHero eyebrow="Data" title="Data dan API" description="Koleksi, format, dan struktur data." />
  <section class="section-wrap developer-page">
    <div class="developer-intro">
      <div>
        <Icon name="layers" size={20} /><p><span>4</span><small>Koleksi data</small></p>
      </div><div>
        <Icon name="database" size={20} /><p>
          <span
            >{
              formatNumber(
                data.stats.dictionaryRecords +
                  data.stats.bakuRecords +
                  data.stats.sinonimRecords +
                  data.stats.antonimRecords,
              )
            }</span
          ><small>Total record</small>
        </p>
      </div><div>
        <Icon name="table" size={20} /><p><span>11</span><small>Format tersedia</small></p>
      </div><div>
        <Icon name="file" size={20} /><p><span>JSON</span><small>Format sumber</small></p>
      </div>
    </div>
    <section class="api-integration" aria-labelledby="api-integration-title">
      <div class="api-brand" aria-hidden="true">
        <span><Icon name="php" size={44} /></span><i>+</i><span
          ><Icon name="codeigniter" size={38} /></span
        >
      </div><div class="api-copy">
        <p class="eyebrow"><span></span>API</p><h2 id="api-integration-title">Search API</h2><p>
          API Hono dan SQLite dijalankan terpisah dari UI. Atur CORS untuk domain UI.
        </p><div class="api-links">
          <a class="primary-button" href={sitePath("/about/")}>Lihat arsitektur</a><a
            href={repositoryUrl}
            target="_blank"
            rel="noreferrer">Repositori ↗</a
          >
        </div>
      </div>
    </section>
    <section class="developer-section" aria-labelledby="dataset-table-title">
      <header class="developer-heading">
        <div>
          <p class="eyebrow"><span></span>Data</p><h2 id="dataset-table-title">
            Koleksi dan format
          </h2>
        </div><p>File sumber tetap tersedia di repositori.</p>
      </header><div class="table-frame">
        <table class="data-table">
          <thead
            ><tr
              ><th>Koleksi</th><th>Tipe data</th><th>Record</th><th>Format tersedia</th><th
                ><span class="sr-only">Akses</span></th
              ></tr
            ></thead
          ><tbody
            >{
              datasets.map((dataset) => (
                <tr>
                  <>
                    <td>
                      <>
                        <strong>{dataset.name}</strong>
                        <code>/{dataset.folder}</code>
                      </>
                    </td>
                    <td>{dataset.type}</td>
                    <td>
                      <b>{formatNumber(dataset.records)}</b>
                    </td>
                    <td>
                      <div class="format-list">
                        {dataset.formats.map((format) => (
                          <span class={format === "JSON" ? "primary" : undefined}>{format}</span>
                        ))}
                      </div>
                    </td>
                    <td>
                      <a
                        href={`${repositoryUrl}/tree/main/${dataset.folder}`}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`Buka folder ${dataset.name}`}
                      >
                        ↗
                      </a>
                    </td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </section>
    <section class="developer-section" aria-labelledby="schema-table-title">
      <header class="developer-heading">
        <div>
          <p class="eyebrow"><span></span>JSON</p><h2 id="schema-table-title">Struktur field</h2>
        </div><p>Setiap file memakai objek root dan array record.</p>
      </header><div class="table-frame">
        <table class="data-table schema-table">
          <thead
            ><tr><th>Dataset</th><th>Root key</th><th>Field record</th><th>Keterangan</th></tr
            ></thead
          ><tbody
            >{
              schemas.map((schema) => (
                <tr>
                  <>
                    <td>
                      <strong>{schema.dataset}</strong>
                    </td>
                    <td>
                      <code>{schema.root}</code>
                    </td>
                    <td>
                      <div class="field-list">
                        {schema.fields.map((field) => (
                          <code>{field}</code>
                        ))}
                      </div>
                    </td>
                    <td>{schema.note}</td>
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </section>
    <aside class="developer-note">
      <Icon name="info" size={24} /><div>
        <strong>Catatan</strong><p>
          Halaman kata memakai SSR dan SQLite read-only. Pencarian memakai API. Browser tidak
          mengunduh seluruh indeks.
        </p>
      </div><a href={repositoryUrl} target="_blank" rel="noreferrer">↗ Repository</a>
    </aside>
  </section>
</BaseLayout>
