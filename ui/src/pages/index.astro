---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../lib/Icon.svelte";
import { loadSiteData } from "../lib/build-data.js";
import { repositoryUrl, sitePath } from "../lib/site.js";

export const prerender = true;

const data = await loadSiteData();
const formatNumber = (value: number) => new Intl.NumberFormat("id-ID").format(value ?? 0);
const collections = [
  {
    route: "/huruf/a/",
    icon: "book",
    title: "Kamus Utama",
    text: "Definisi kata dari KBBI Edisi IV.",
    count: data.stats.dictionaryRecords,
  },
  {
    route: "/search/?type=baku",
    icon: "check",
    title: "Baku & Nonbaku",
    text: "Bentuk baku dan nonbaku.",
    count: data.stats.bakuRecords,
  },
  {
    route: "/search/?type=sinonim",
    icon: "link",
    title: "Sinonim",
    text: "Kata dengan makna yang mirip.",
    count: data.stats.sinonimRecords,
  },
  {
    route: "/search/?type=antonim",
    icon: "swap",
    title: "Antonim",
    text: "Kata dengan makna berlawanan.",
    count: data.stats.antonimRecords,
  },
];
const sources = [
  { name: "Ican Bachors · KBBI.sql", url: "https://github.com/bachors/KBBI.sql" },
  { name: "kbbi-v6-full-csv", url: "https://github.com/aryakdaniswara/kbbi-v6-full-csv" },
  { name: "kbbi-v6-categories", url: "https://github.com/aryakdaniswara/kbbi-v6-categories" },
  { name: "kbbi-v6-wordlist", url: "https://github.com/aryakdaniswara/kbbi-v6-wordlist" },
  { name: "kbbi-dataset-kbbi-v", url: "https://github.com/aryakdaniswara/kbbi-dataset-kbbi-v" },
  { name: "raf555 · KBBI-api", url: "https://github.com/raf555/kbbi-api" },
];
---

<BaseLayout
  title="KBBI Data Explorer"
  description="Cari arti, kata baku, sinonim, dan antonim Bahasa Indonesia. Bukan layanan resmi KBBI."
  canonicalPath="/"
>
  <section class="home-hero">
    <div class="home-copy">
      <p class="eyebrow"><span></span>Dataset terbuka · Bukan layanan resmi</p>
      <h1>Cari arti kata.</h1>
      <p>Cari arti, kata baku, sinonim, dan antonim Bahasa Indonesia.</p>
      <div class="hero-actions">
        <a class="primary-button" href={sitePath("/search/")}>Cari kata <Icon name="arrow" /></a>
        <a href={repositoryUrl} target="_blank" rel="noreferrer">Repositori ↗</a>
      </div>
    </div>
    <div class="word-art" aria-hidden="true">
      <span class="letter letter-k">K</span><span class="letter letter-b">B</span><span
        class="letter letter-i">I</span
      >
      <p><strong>ka·ta</strong> <i>n</i> unsur bahasa yang diucapkan atau dituliskan.</p>
    </div>
  </section>

  <section class="stats" aria-label="Statistik dataset">
    {
      collections.map((item) => (
        <div>
          <>
            <strong>{formatNumber(item.count)}</strong>
            <span>{item.title}</span>
          </>
        </div>
      ))
    }
  </section>

  <section class="section-wrap home-collections">
    <header class="section-heading">
      <p class="eyebrow"><span></span>Data</p><h2>Koleksi data</h2>
    </header>
    <div class="collection-grid">
      {
        collections.map((item, index) => (
          <a
            class:list={["collection-card", index === 0 && "featured"]}
            href={sitePath(item.route)}
          >
            <span class="icon-badge">
              <Icon name={item.icon} size={24} />
            </span>
            <span>
              <>
                <small>0{index + 1}</small>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <b>{formatNumber(item.count)} entri</b>
              </>
            </span>
            <Icon name="arrow" />
          </a>
        ))
      }
    </div>
  </section>

  <section class="section-wrap sources-section" aria-labelledby="sources-title">
    <div class="sources-intro">
      <p class="eyebrow"><span></span>Sumber</p><h2 id="sources-title">Sumber data</h2><p>
        Data dihimpun dari beberapa repositori publik. Sebagian data relasi diperkaya dengan AI.
      </p>
    </div>
    <div class="source-list">
      {
        sources.map((source, index) => (
          <a href={source.url} target="_blank" rel="noreferrer">
            <>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{source.name}</strong>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
      <div class="ai-source">
        <span>AI</span><p>
          <strong>Data relasi</strong><small
            >Baku & Nonbaku, Sinonim, dan Antonim diperkaya dengan AI.</small
          >
        </p>
      </div>
    </div>
  </section>

  <section class="section-wrap app-showcase" aria-labelledby="app-showcase-title">
    <div class="app-visual" aria-hidden="true">
      <div class="phone-frame">
        <img src={sitePath("/kbbi-logo.png")} alt="" width="130" height="130" /><span>MyKBBI</span
        ><small>Kamus Indonesia</small>
      </div>
    </div>
    <div class="app-copy">
      <p class="eyebrow"><span></span>Aplikasi</p><h2 id="app-showcase-title">MyKBBI</h2><p>
        Aplikasi Android untuk mencari kosakata Bahasa Indonesia.
      </p><a
        class="play-store-button"
        href="https://play.google.com/store/apps/details?id=com.kang.cahya.apps.mykbbi"
        target="_blank"
        rel="noreferrer"
        ><Icon name="play" size={24} /><span
          ><small>Unduh di</small><strong>Google Play</strong></span
        ><span aria-hidden="true">↗</span></a
      >
    </div>
  </section>

  <section class="section-wrap data-notice" aria-labelledby="data-ownership-title">
    <div class="notice-heading">
      <p class="eyebrow"><span></span>Hak data</p><h2 id="data-ownership-title">
        Periksa sumber dan ketentuannya.
      </h2>
    </div><div class="notice-content">
      <p>
        Seluruh data kamus dimiliki oleh <strong
          >Badan Pengembangan dan Pembinaan Bahasa, Kementerian Pendidikan Dasar dan Menengah
          Republik Indonesia</strong
        >.
      </p><p>
        Penggunaan komersial mengikuti Undang-Undang Republik Indonesia Nomor 28 Tahun 2014 tentang
        Hak Cipta.
      </p>
    </div>
  </section>
</BaseLayout>
