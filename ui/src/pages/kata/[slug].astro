---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWordPage } from "../../lib/server-data.js";
import { absoluteRoute, sitePath } from "../../lib/site.js";

export const prerender = false;

type Definition = { html: string; text: string; type: number | null };
type Related = { word: string; slug: string; kind: string };
type Neighbor = { word: string; slug: string } | null;
type WordPage = {
  id: number;
  word: string;
  normalizedWord: string;
  slug: string;
  letter: string;
  definitions: Definition[];
  related: Related[];
  previous: Neighbor;
  next: Neighbor;
};
const entry = getWordPage(Astro.params.slug ?? "") as WordPage | null;
if (!entry) Astro.response.status = 404;
const definitions = entry?.definitions ?? [];
const related = entry?.related ?? [];
const definitionText =
  definitions.map((item: Definition) => item.text).join(" ") || "Kata tidak ditemukan.";
const description = entry
  ? `${entry.word}: ${definitionText.slice(0, 150)}${definitionText.length > 150 ? "…" : ""}`
  : "Entri kamus yang diminta tidak ditemukan.";
const jsonLd = entry
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "DefinedTerm",
          name: entry.word,
          description: definitionText.slice(0, 500),
          inDefinedTermSet: { "@type": "DefinedTermSet", name: "KBBI Data Explorer" },
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Beranda", item: absoluteRoute("/") },
            {
              "@type": "ListItem",
              position: 2,
              name: "Daftar kata",
              item: absoluteRoute(`/huruf/${entry.letter}/`),
            },
            {
              "@type": "ListItem",
              position: 3,
              name: entry.word,
              item: absoluteRoute(`/kata/${entry.slug}/`),
            },
          ],
        },
      ],
    }
  : undefined;
Astro.response.headers.set(
  "Cache-Control",
  entry
    ? "public, max-age=300, s-maxage=604800, stale-while-revalidate=86400"
    : "public, max-age=60",
);
if (entry) Astro.response.headers.set("ETag", `"tutur-word-${entry.id}"`);
---

<BaseLayout
  title={entry
    ? `Arti kata ${entry.word} | KBBI Data Explorer`
    : "Kata tidak ditemukan | KBBI Data Explorer"}
  description={description}
  robots={entry ? "index, follow" : "noindex, follow"}
  canonicalPath={entry ? `/kata/${entry.slug}/` : "/404/"}
  jsonLd={jsonLd}
>
  {
    entry ? (
      <article class="word-page section-wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <>
              <li>
                <a href={sitePath("/")}>Beranda</a>
              </li>
              <li>
                <a href={sitePath(`/huruf/${entry.letter}/`)}>Daftar kata</a>
              </li>
              <li aria-current="page">{entry.word}</li>
            </>
          </ol>
        </nav>
        <header class="word-heading">
          <>
            <p class="eyebrow">
              <span />
              Entri kamus
            </p>
            <h1>{entry.word}</h1>
            <p class="word-normalized">
              Bentuk terindeks: <span>{entry.normalizedWord}</span>
            </p>
          </>
        </header>
        <div class="word-content-grid">
          <section class="word-definitions" aria-labelledby="definitions-title">
            <>
              <div class="word-section-heading">
                <>
                  <p class="eyebrow">
                    <span />
                    Definisi
                  </p>
                  <h2 id="definitions-title">Arti</h2>
                </>
              </div>
              <ol class="definitions">
                {definitions.map((definition: Definition) => (
                  <li>
                    <span>{definition.type == null ? "Makna" : `Tipe ${definition.type}`}</span>
                    <div set:html={definition.html} />
                  </li>
                ))}
              </ol>
            </>
          </section>
          <aside class="word-aside">
            <>
              <div class="unofficial-notice">
                <>
                  <strong>Layanan</strong>
                  <p>
                    Explorer ini bukan layanan resmi KBBI. Data dimiliki oleh Badan Pengembangan dan
                    Pembinaan Bahasa.
                  </p>
                </>
              </div>
              <div class="source-note">
                <>
                  <strong>Sumber</strong>
                  <p>
                    Definisi berasal dari dataset referensi KBBI SQL Database. Periksa ketentuan
                    penggunaan.
                  </p>
                </>
              </div>
            </>
          </aside>
        </div>
        {related.length > 0 && (
          <section class="related-words" aria-labelledby="related-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Relasi kata
              </p>
              <h2 id="related-title">Kata terkait</h2>
            </div>
            <ul>
              {related.slice(0, 16).map((item: Related) => (
                <li>
                  <a href={sitePath(`/kata/${item.slug}/`)}>
                    <strong>{item.word}</strong>
                    <small>{item.kind}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <nav class="word-neighbors" aria-label="Navigasi entri">
          {entry.previous ? (
            <a href={sitePath(`/kata/${entry.previous.slug}/`)}>
              <small>Sebelumnya</small>
              <strong>← {entry.previous.word}</strong>
            </a>
          ) : (
            <span />
          )}
          {entry.next ? (
            <a href={sitePath(`/kata/${entry.next.slug}/`)}>
              <small>Berikutnya</small>
              <strong>{entry.next.word} →</strong>
            </a>
          ) : (
            <span />
          )}
        </nav>
      </article>
    ) : (
      <section class="not-found section-wrap">
        <>
          <p class="eyebrow">
            <span />
            404
          </p>
          <h1>Kata tidak ditemukan.</h1>
          <p>Slug tersebut tidak memiliki entri.</p>
          <a class="primary-button" href={sitePath("/search/")}>
            Kembali ke pencarian
          </a>
        </>
      </section>
    )
  }
</BaseLayout>
