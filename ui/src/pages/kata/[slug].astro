---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WordGraph from "../../components/WordGraph.svelte";
import { getWordPage, getWordGraph } from "../../lib/server-data.js";
import { absoluteRoute, sitePath } from "../../lib/site.js";

export const prerender = false;

type Definition = { html: string; text: string; type: number | null };
type Related = { word: string; slug: string; kind: string };
type Neighbor = { word: string; slug: string } | null;
type ExtraItem = { text: string; slug: string | null };
type EtymologyRelation = {
  relationType: string;
  relatedLang: string | null;
  relatedTerm: string | null;
};
type KaikkiForm = { text: string; tags: string[] };
type KaikkiEntry = {
  partOfSpeech: string;
  etymology: string | null;
  pronunciations: string[];
  hyphenations: string[];
  forms: KaikkiForm[];
  derived: string[];
  synonyms: string[];
};
type Extras = {
  pronunciation: string | null;
  etymology: string | null;
  examples: ExtraItem[];
  derivations: ExtraItem[];
  compounds: ExtraItem[];
  proverbs: ExtraItem[];
  idioms: ExtraItem[];
};
type SlangForm = { slang: string; formal: string; categories: string[] };
type SlangTarget = { word: string; slug: string };
type FamilyMember = { word: string; slug: string | null; frequency: number };
type WordPage = {
  id: number;
  word: string;
  normalizedWord: string;
  slug: string;
  letter: string;
  summary: string;
  syllabifications: string[];
  frequency: number | null;
  root: string | null;
  rootRank: number | null;
  rootWord: string | null;
  rootSlug: string | null;
  definitions: Definition[];
  etymologyRelations: EtymologyRelation[];
  kaikkiEntries: KaikkiEntry[];
  extras: Extras | null;
  slangForms: SlangForm[];
  slangTargets: SlangTarget[];
  family: FamilyMember[];
  related: Related[];
  previous: Neighbor;
  next: Neighbor;
};
const entry = getWordPage(Astro.params.slug ?? "") as WordPage | null;
if (!entry) Astro.response.status = 404;
const graph = entry ? getWordGraph(entry.slug) : null;
const maxGraphSig = graph ? Math.max(...graph.nodes.map((node) => node.sig), 1) : 1;
const exampleHtml = (sentence: string) =>
  sentence
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replace(/«([^»]*)»/g, "<strong>$1</strong>")
    .replace(/[«»]/g, "");
const definitions = entry?.definitions ?? [];
const etymologyRelations = entry?.etymologyRelations ?? [];
const kaikkiEntries = entry?.kaikkiEntries ?? [];
const extras = entry?.extras ?? null;
const related = entry?.related ?? [];
const family = entry?.family ?? [];
const slangForms = entry?.slangForms ?? [];
const slangTargets = entry?.slangTargets ?? [];
type ReadingValue = { value: string; sources: string[] };
const combineReadingValues = (
  items: { value: string; source: string }[],
  normalizeSeparators = false,
) => {
  const combined = new Map<string, ReadingValue>();
  for (const item of items) {
    const value = normalizeSeparators
      ? item.value.trim().replace(/[.‧]/gu, "·")
      : item.value.trim();
    if (!value) continue;
    const key = value.toLocaleLowerCase("id-ID");
    const existing = combined.get(key);
    if (existing) {
      if (!existing.sources.includes(item.source)) existing.sources.push(item.source);
    } else {
      combined.set(key, { value, sources: [item.source] });
    }
  }
  return [...combined.values()];
};
const syllabifications = combineReadingValues(
  [
    ...(entry?.syllabifications ?? []).map((value) => ({ value, source: "KBBI IV" })),
    ...kaikkiEntries.flatMap((item) =>
      item.hyphenations.map((value) => ({ value, source: "Kaikki" })),
    ),
  ],
  true,
);
const pronunciations = combineReadingValues([
  ...(extras?.pronunciation
    ? [
        {
          value: extras.pronunciation.startsWith("/")
            ? extras.pronunciation
            : `/${extras.pronunciation}/`,
          source: "KBBI VI",
        },
      ]
    : []),
  ...kaikkiEntries.flatMap((item) =>
    item.pronunciations.map((value) => ({ value, source: "Kaikki · IPA" })),
  ),
]);
const formatNumber = (value: number) => new Intl.NumberFormat("id-ID").format(value ?? 0);
const etymologyLabels: Record<string, string> = {
  "back-formation_from": "Dibentuk balik dari",
  blend_of: "Paduan dari",
  borrowed_from: "Dipinjam dari",
  calque_of: "Terjemahan langsung dari",
  clipping_of: "Pemendekan dari",
  cognate_of: "Berkerabat dengan",
  compound_of: "Gabungan dari",
  derived_from: "Berasal dari",
  doublet_with: "Berstem sama dengan",
  etymologically_related_to: "Berkerabat secara etimologis dengan",
  has_affix: "Menggunakan afiks",
  has_confix: "Menggunakan konfiks",
  has_prefix: "Menggunakan awalan",
  has_prefix_with_root: "Awalan pada akar",
  has_root: "Berakar pada",
  has_suffix: "Menggunakan akhiran",
  has_suffix_with_root: "Akhiran pada akar",
  inherited_from: "Diwariskan dari",
  initialism_of: "Inisial dari",
  is_onomatopoeic: "Bersifat onomatope",
  learned_borrowing_from: "Dipinjam melalui jalur terpelajar dari",
  "phono-semantic_matching_of": "Penyesuaian bunyi-makna dari",
  semantic_loan_of: "Pinjaman makna dari",
  unadapted_borrowing_from: "Dipinjam tanpa adaptasi dari",
};
const etymologyLabel = (relationType: string) =>
  etymologyLabels[relationType] ?? relationType.replaceAll("_", " ");
const definitionText =
  definitions.map((item: Definition) => item.text).join(" ") || "Kata tidak ditemukan.";
const description = entry
  ? `${entry.word}: ${definitionText.slice(0, 150)}${definitionText.length > 150 ? "…" : ""}`
  : "Entri kamus yang diminta tidak ditemukan.";
const jsonLd = entry
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "DefinedTerm",
          name: entry.word,
          description: definitionText.slice(0, 500),
          inDefinedTermSet: { "@type": "DefinedTermSet", name: "Tutur" },
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Beranda", item: absoluteRoute("/") },
            {
              "@type": "ListItem",
              position: 2,
              name: "Daftar kata",
              item: absoluteRoute(`/huruf/${entry.letter}/`),
            },
            {
              "@type": "ListItem",
              position: 3,
              name: entry.word,
              item: absoluteRoute(`/kata/${entry.slug}/`),
            },
          ],
        },
      ],
    }
  : undefined;
Astro.response.headers.set(
  "Cache-Control",
  entry
    ? "public, max-age=300, s-maxage=604800, stale-while-revalidate=86400"
    : "public, max-age=60",
);
if (entry) Astro.response.headers.set("ETag", `"tutur-word-${entry.id}"`);
---

<BaseLayout
  title={entry ? `Arti kata ${entry.word} | Tutur` : "Kata tidak ditemukan | Tutur"}
  description={description}
  robots={entry ? "index, follow" : "noindex, follow"}
  canonicalPath={entry ? `/kata/${entry.slug}/` : "/404/"}
  image={entry ? `/og/kata/${entry.slug}.png` : undefined}
  imageAlt={entry ? `Arti kata ${entry.word}` : undefined}
  jsonLd={jsonLd}
>
  {
    entry ? (
      <article class="word-page section-wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <>
              <li>
                <a href={sitePath("/")}>Beranda</a>
              </li>
              <li>
                <a href={sitePath(`/huruf/${entry.letter}/`)}>Daftar kata</a>
              </li>
              <li aria-current="page">{entry.word}</li>
            </>
          </ol>
        </nav>
        <header class="word-heading">
          <>
            <p class="eyebrow">
              <span />
              Entri kamus
            </p>
            <h1>{entry.word}</h1>
            {(syllabifications.length > 0 || pronunciations.length > 0) && (
              <dl class="word-readings">
                {syllabifications.length > 0 && (
                  <div>
                    <dt>Pemenggalan</dt>
                    <dd>
                      {syllabifications.map((item: ReadingValue) => (
                        <span>
                          <b>{item.value}</b>
                          <small>{item.sources.join(" + ")}</small>
                        </span>
                      ))}
                    </dd>
                  </div>
                )}
                {pronunciations.length > 0 && (
                  <div>
                    <dt>Pelafalan</dt>
                    <dd>
                      {pronunciations.map((item: ReadingValue) => (
                        <span>
                          <b>{item.value}</b>
                          <small>{item.sources.join(" + ")}</small>
                        </span>
                      ))}
                    </dd>
                  </div>
                )}
              </dl>
            )}
            <p class="word-normalized">
              Bentuk terindeks: <span>{entry.normalizedWord}</span>
            </p>
            {(entry.frequency != null || entry.rootWord) && (
              <div class="word-meta">
                {entry.frequency != null && (
                  <span class="meta-chip">
                    Frekuensi korpus: <b>{formatNumber(entry.frequency)}</b>
                  </span>
                )}
                {entry.rootWord && (
                  <a class="meta-chip is-link" href={sitePath(`/kata/${entry.rootSlug}/`)}>
                    Akar kata: <b>{entry.rootWord}</b>
                  </a>
                )}
              </div>
            )}
          </>
        </header>
        <div class="word-content-grid">
          <section class="word-definitions" aria-labelledby="definitions-title">
            <>
              <div class="word-section-heading">
                <>
                  <p class="eyebrow">
                    <span />
                    Definisi
                  </p>
                  <h2 id="definitions-title">Arti</h2>
                </>
              </div>
              <ol class="definitions">
                {definitions.map((definition: Definition) => (
                  <li>
                    <span>{definition.type == null ? "Makna" : `Tipe ${definition.type}`}</span>
                    <div set:html={definition.html} />
                  </li>
                ))}
              </ol>
            </>
          </section>
          <aside class="word-aside">
            <>
              {extras?.etymology && (
                <div class="source-note">
                  <>
                    <strong>Etimologi KBBI VI</strong>
                    <p>{extras.etymology}</p>
                  </>
                </div>
              )}
              {graph && (
                <div class="source-note">
                  <>
                    <strong>Korpus</strong>
                    <p>
                      Muncul {graph.sentences}× dalam {formatNumber(graph.corpusSentences)} kalimat
                      korpus Leipzig ind_mixed_2013.
                    </p>
                  </>
                </div>
              )}
            </>
          </aside>
        </div>
        {etymologyRelations.length > 0 && (
          <section class="word-extras" aria-labelledby="etymology-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Asal-usul kata
              </p>
              <h2 id="etymology-title">Etimologi</h2>
            </div>
            <p class="etymology-note">
              Relasi ini berasal dari{" "}
              <a
                href="https://github.com/ManaSiWibi/KBBI-SQL-database/tree/main/etymology-db"
                target="_blank"
                rel="noreferrer"
              >
                etymology-db
              </a>{" "}
              dan diparsing dari Wiktionary; hasilnya belum divalidasi secara sistematis.
            </p>
            <ul class="example-list etymology-list">
              {etymologyRelations.map((relation: EtymologyRelation) => (
                <li>
                  <span class="example-kind">{etymologyLabel(relation.relationType)}</span>
                  <p>
                    {relation.relatedTerm ? (
                      <>
                        {relation.relatedLang && <span>{relation.relatedLang}: </span>}
                        <em>{relation.relatedTerm}</em>
                      </>
                    ) : (
                      "Tidak ada kata terkait yang dicatat."
                    )}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )}
        {kaikkiEntries.length > 0 && (
          <section class="word-extras" aria-labelledby="kaikki-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Kaikki · Wiktionary
              </p>
              <h2 id="kaikki-title">Data leksikal</h2>
            </div>
            <p class="etymology-note">
              Data tambahan ini diekstrak oleh Wiktextract dan disediakan melalui{" "}
              <a
                href="https://kaikki.org/dictionary/Indonesian/index.html"
                target="_blank"
                rel="noreferrer"
              >
                Kaikki
              </a>
              ; bukan definisi resmi KBBI. Teks sumber mengikuti{" "}
              <a
                href="https://en.wiktionary.org/wiki/Wiktionary:Copyrights"
                target="_blank"
                rel="noreferrer"
              >
                ketentuan lisensi Wiktionary
              </a>
              .
            </p>
            <div class="kaikki-list">
              {kaikkiEntries.map((item: KaikkiEntry) => (
                <article class="kaikki-entry">
                  <header class="kaikki-entry-header">
                    <strong>{item.partOfSpeech}</strong>
                  </header>
                  {item.etymology && (
                    <p>
                      <b>Etimologi:</b> {item.etymology}
                    </p>
                  )}
                  {item.forms.length > 0 && (
                    <p>
                      <b>Bentuk:</b>{" "}
                      {item.forms.map((form: KaikkiForm, index: number) => (
                        <span>
                          {index > 0 && ", "}
                          {form.text}
                          {form.tags.length > 0 && <small> ({form.tags.join(", ")})</small>}
                        </span>
                      ))}
                    </p>
                  )}
                  {item.synonyms.length > 0 && (
                    <p>
                      <b>Sinonim:</b> {item.synonyms.join(", ")}
                    </p>
                  )}
                  {item.derived.length > 0 && (
                    <p>
                      <b>Turunan:</b> {item.derived.join(", ")}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}
        {graph && (
          <section class="word-graph-section" aria-labelledby="graph-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Korpus Leipzig · ind_mixed_2013
              </p>
              <h2 id="graph-title">Graf kata</h2>
            </div>
            <WordGraph
              client:visible
              word={graph.word}
              anchorId={graph.anchorId}
              nodes={graph.nodes}
              edges={graph.edges}
              slug={entry.slug}
            />
            <p class="word-graph-help">
              Dari {graph.sentences} kalimat korpus (frekuensi {graph.freq}). Angka pada garis
              adalah frekuensi kemunculan berpasangan. Seret node untuk menata; klik node
              bersambungan untuk membuka halaman katanya.
            </p>
            <div class="word-graph-lists">
              <div class="graph-cooc">
                <h3>Kata dalam kalimat yang sama</h3>
                <ol class="cooc-list">
                  {graph.nodes.map((node) => (
                    <li>
                      <span
                        class="cooc-bar"
                        style={`width:${Math.max(8, (node.sig / maxGraphSig) * 100)}%`}
                      />
                      <span class="cooc-count">{node.freq}×</span>
                      {node.slug ? (
                        <a href={sitePath(`/kata/${node.slug}/`)}>{node.word}</a>
                      ) : (
                        <span>{node.word}</span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
              <div class="graph-neighbours">
                <h3>Kata tetangga</h3>
                <div class="neighbour-group">
                  <h4>Sebelum</h4>
                  <ul class="neighbour-list">
                    {graph.left.map((node) => (
                      <li>
                        {node.slug ? (
                          <a href={sitePath(`/kata/${node.slug}/`)}>{node.word}</a>
                        ) : (
                          <span>{node.word}</span>
                        )}
                        <small>{node.freq}×</small>
                      </li>
                    ))}
                    {graph.left.length === 0 && <li class="empty">—</li>}
                  </ul>
                </div>
                <div class="neighbour-group">
                  <h4>Sesudah</h4>
                  <ul class="neighbour-list">
                    {graph.right.map((node) => (
                      <li>
                        {node.slug ? (
                          <a href={sitePath(`/kata/${node.slug}/`)}>{node.word}</a>
                        ) : (
                          <span>{node.word}</span>
                        )}
                        <small>{node.freq}×</small>
                      </li>
                    ))}
                    {graph.right.length === 0 && <li class="empty">—</li>}
                  </ul>
                </div>
              </div>
            </div>
            {graph.examples.length > 0 && (
              <div class="corpus-examples">
                <h3>Contoh dari korpus</h3>
                <ol class="corpus-list">
                  {graph.examples.map((example) => (
                    <li set:html={exampleHtml(example)} />
                  ))}
                </ol>
              </div>
            )}
          </section>
        )}
        {extras?.examples && extras.examples.length > 0 && (
          <section class="word-extras" aria-labelledby="examples-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Konteks pemakaian
              </p>
              <h2 id="examples-title">Contoh penggunaan</h2>
            </div>
            <ol class="example-list">
              {extras.examples.map((item: ExtraItem) => (
                <li>
                  <p>{item.text}</p>
                </li>
              ))}
            </ol>
          </section>
        )}
        {family.length > 0 && (
          <section class="word-extras" aria-labelledby="family-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Kata seakar
              </p>
              <h2 id="family-title">Keluarga kata</h2>
            </div>
            <ul class="chip-list">
              {family.map((member: FamilyMember) => (
                <li>
                  {member.slug ? (
                    <a href={sitePath(`/kata/${member.slug}/`)}>
                      <strong>{member.word}</strong>
                      <small>{formatNumber(member.frequency)}×</small>
                    </a>
                  ) : (
                    <span>
                      <strong>{member.word}</strong>
                      <small>{formatNumber(member.frequency)}×</small>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {(extras?.derivations?.length ?? 0) > 0 && (
          <section class="word-extras" aria-labelledby="derivations-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Bentukan
              </p>
              <h2 id="derivations-title">Turunan</h2>
            </div>
            <ul class="chip-list">
              {extras!.derivations.map((item: ExtraItem) => (
                <li>
                  {item.slug ? (
                    <a href={sitePath(`/kata/${item.slug}/`)}>
                      <strong>{item.text}</strong>
                    </a>
                  ) : (
                    <span>
                      <strong>{item.text}</strong>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {(extras?.compounds?.length ?? 0) > 0 && (
          <section class="word-extras" aria-labelledby="compounds-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Rakitan kata
              </p>
              <h2 id="compounds-title">Gabungan kata</h2>
            </div>
            <ul class="chip-list">
              {extras!.compounds.map((item: ExtraItem) => (
                <li>
                  {item.slug ? (
                    <a href={sitePath(`/kata/${item.slug}/`)}>
                      <strong>{item.text}</strong>
                    </a>
                  ) : (
                    <span>
                      <strong>{item.text}</strong>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {((extras?.proverbs?.length ?? 0) > 0 || (extras?.idioms?.length ?? 0) > 0) && (
          <section class="word-extras" aria-labelledby="idioms-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Ungkapan
              </p>
              <h2 id="idioms-title">Peribahasa dan kiasan</h2>
            </div>
            <ul class="example-list">
              {(extras?.proverbs ?? []).map((item: ExtraItem) => (
                <li>
                  <span class="example-kind">Peribahasa</span>
                  <p>{item.text}</p>
                </li>
              ))}
              {(extras?.idioms ?? []).map((item: ExtraItem) => (
                <li>
                  <span class="example-kind">Kiasan</span>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
          </section>
        )}
        {slangForms.length > 0 && (
          <section class="word-extras" aria-labelledby="slang-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Bahasa sehari-hari
              </p>
              <h2 id="slang-title">Bentuk slang</h2>
            </div>
            <p class="slang-note">Dalam percakapan santai, kata ini sering ditulis:</p>
            <ul class="chip-list">
              {slangForms.map((form: SlangForm) => (
                <li>
                  <span class="slang-chip">
                    <strong>{form.slang}</strong>
                    {form.categories.length > 0 && <small>{form.categories.join(", ")}</small>}
                  </span>
                </li>
              ))}
            </ul>
            {slangTargets.length > 0 && (
              <p class="slang-note">
                Kata ini juga dipakai sebagai bentuk santai dari{" "}
                {slangTargets.map((target: SlangTarget, index: number) => (
                  <>
                    <a href={sitePath(`/kata/${target.slug}/`)}>
                      <strong>{target.word}</strong>
                    </a>
                    {index < slangTargets.length - 1 && ", "}
                  </>
                ))}
                .
              </p>
            )}
          </section>
        )}
        {related.length > 0 && (
          <section class="related-words" aria-labelledby="related-title">
            <div class="word-section-heading">
              <p class="eyebrow">
                <span />
                Relasi kata
              </p>
              <h2 id="related-title">Kata terkait</h2>
            </div>
            <ul>
              {related.slice(0, 16).map((item: Related) => (
                <li>
                  <a href={sitePath(`/kata/${item.slug}/`)}>
                    <strong>{item.word}</strong>
                    <small>{item.kind}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <nav class="word-neighbors" aria-label="Navigasi entri">
          {entry.previous ? (
            <a href={sitePath(`/kata/${entry.previous.slug}/`)}>
              <small>Sebelumnya</small>
              <strong>← {entry.previous.word}</strong>
            </a>
          ) : (
            <span />
          )}
          {entry.next ? (
            <a href={sitePath(`/kata/${entry.next.slug}/`)}>
              <small>Berikutnya</small>
              <strong>{entry.next.word} →</strong>
            </a>
          ) : (
            <span />
          )}
        </nav>
      </article>
    ) : (
      <section class="not-found section-wrap">
        <>
          <p class="eyebrow">
            <span />
            404
          </p>
          <h1>Kata tidak ditemukan.</h1>
          <p>Slug tersebut tidak memiliki entri.</p>
          <a class="primary-button" href={sitePath("/search/")}>
            Kembali ke pencarian
          </a>
        </>
      </section>
    )
  }
</BaseLayout>
