---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchIsland from "../components/SearchIsland.svelte";

export const prerender = true;

const type = Astro.url.searchParams.get("type") || "all";
const validType = ["all", "dictionary", "baku", "sinonim", "antonim", "slang"].includes(type)
  ? type
  : "all";
---

<BaseLayout
  title="Pencarian Global | Tutur"
  description="Cari arti, kata baku, sinonim, atau antonim Bahasa Indonesia."
  canonicalPath="/search/"
  robots="noindex, follow"
  currentPath="/search/"
>
  <SearchIsland client:load initialType={validType} />
</BaseLayout>
