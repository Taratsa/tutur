---
import AlphabetPage from "../../components/AlphabetPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAvailableLetters, getLetterPage } from "../../lib/server-data.js";
import { sitePath } from "../../lib/site.js";

export const prerender = false;

const requestedLetter = Astro.params.letter ?? "";
const pageData = getLetterPage(requestedLetter, 1);
if (pageData && requestedLetter !== pageData.letter)
  return Astro.redirect(sitePath(`/huruf/${pageData.letter}/`), 308);
if (!pageData || pageData.totalPages === 0) Astro.response.status = 404;
const availableLetters = getAvailableLetters();
const label = pageData
  ? pageData.letter === "0-9"
    ? "angka"
    : pageData.letter === "lainnya"
      ? "simbol dan Unicode"
      : pageData.letter.toUpperCase()
  : "huruf";
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400",
);
---

<BaseLayout
  title={pageData ? `Kata berawalan ${label} | Tutur` : "Daftar kata tidak ditemukan | Tutur"}
  description={pageData
    ? `Daftar kata Bahasa Indonesia yang berawalan ${label}, dengan tautan ke definisi lengkap.`
    : "Daftar kata yang diminta tidak ditemukan."}
  robots={pageData ? "index, follow" : "noindex, follow"}
  canonicalPath={pageData ? `/huruf/${pageData.letter}/` : "/404/"}
  currentPath={pageData ? `/huruf/${pageData.letter}/` : "/"}
>
  {
    pageData ? (
      <AlphabetPage pageData={pageData} availableLetters={availableLetters} />
    ) : (
      <section class="not-found section-wrap">
        <>
          <p class="eyebrow">
            <span />
            404
          </p>
          <h1>Daftar kata tidak ditemukan.</h1>
          <p>Huruf atau halaman yang diminta tidak tersedia.</p>
          <a class="primary-button" href={sitePath("/")}>
            Kembali ke beranda
          </a>
        </>
      </section>
    )
  }
</BaseLayout>
