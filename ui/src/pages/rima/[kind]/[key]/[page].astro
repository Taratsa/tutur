---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import RhymePage from "../../../../components/RhymePage.astro";
import { getRhymeGroup } from "../../../../lib/server-data.js";
import { rhymeDisplay, rhymeKindLabel, rhymePath } from "../../../../lib/rhyme.js";
import { sitePath } from "../../../../lib/site.js";

export const prerender = false;

const requestedKind = Astro.params.kind ?? "";
const requestedKey = Astro.params.key ?? "";
const key = requestedKey.toLocaleLowerCase("id-ID");
const rawPage = Astro.params.page ?? "";
const pageNumber = Number.parseInt(rawPage, 10);
if (requestedKey !== key || (pageNumber === 1 && rawPage === "1"))
  return Astro.redirect(sitePath(rhymePath(requestedKind, key)), 308);
const pageData =
  /^\d+$/u.test(rawPage) && String(pageNumber) === rawPage && pageNumber > 1
    ? getRhymeGroup(requestedKind, key, pageNumber)
    : null;
if (!pageData) Astro.response.status = 404;
const display = pageData ? rhymeDisplay(pageData.key, pageData.kind) : "";
const kindLabel = rhymeKindLabel(requestedKind);
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400",
);
---

<BaseLayout
  title={pageData
    ? `Kata berima ${display}, halaman ${pageData.page} | Tutur`
    : "Grup rima tidak ditemukan | Tutur"}
  description={pageData
    ? `Daftar kata ${kindLabel} ${display} dalam KBBI, halaman ${pageData.page}.`
    : "Grup rima yang diminta tidak ditemukan."}
  robots={pageData ? "index, follow" : "noindex, follow"}
  canonicalPath={pageData ? rhymePath(pageData.kind, pageData.key, pageData.page) : "/404/"}
  currentPath={pageData ? rhymePath(pageData.kind, pageData.key, pageData.page) : "/"}
>
  {
    pageData ? (
      <RhymePage pageData={pageData} />
    ) : (
      <section class="not-found section-wrap">
        <>
          <p class="eyebrow">
            <span />
            404
          </p>
          <h1>Grup rima tidak ditemukan.</h1>
          <p>Belum ada kata KBBI dengan bunyi rima tersebut.</p>
          <a class="primary-button" href={sitePath("/rima/")}>
            Lihat grup rima lain
          </a>
        </>
      </section>
    )
  }
</BaseLayout>
