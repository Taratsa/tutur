---
import "@fontsource-variable/inter";
import "../style.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { absoluteRoute, sitePath } from "../lib/site.js";

const {
  title,
  description,
  canonicalPath = "/",
  robots = "index, follow",
  jsonLd,
  currentPath = canonicalPath,
} = Astro.props;
const canonicalUrl = absoluteRoute(canonicalPath);
const serializedJsonLd = jsonLd ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c") : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" type="image/png" href={sitePath("/favicon.png")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    {
      serializedJsonLd && (
        <script is:inline type="application/ld+json" set:html={serializedJsonLd} />
      )
    }
  </head>
  <body>
    <SiteHeader currentPath={currentPath} />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>
