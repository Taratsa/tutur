{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": false,
    "types": ["bun"]
  },
  "include": ["api/src/**/*.ts", "shared/src/**/*.ts"]
}
