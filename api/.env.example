PORT=3001
SEARCH_DB_PATH=./data/search.sqlite
CORS_ORIGIN=http://localhost:4321
RATE_LIMIT_PER_MINUTE=120
# Set 1 hanya jika berada di belakang reverse proxy (Caddy/nginx) yang
# menyetel x-forwarded-for, agar rate limiter memilah klien per IP.
TRUST_PROXY=0
# Cache respons /api/search dalam proses (milidetik; 0 = matikan).
SEARCH_CACHE_TTL=60000
SEARCH_CACHE_MAX=2048
